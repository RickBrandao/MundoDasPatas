# Copie para backend/.env (NUNCA versionado) e ajuste. Variáveis do sistema têm prioridade sobre o arquivo.

# local | test | staging | production
# staging/production validam a configuração e recusam iniciar se algo estiver inseguro ou faltando.
APP_ENV=local
LOG_LEVEL=INFO

# Origens do navegador autorizadas (separadas por vírgula, sem barra final). Nunca "*" em staging/produção.
# Dev do frontend (Vite): http://localhost:5173 (acrescente http://127.0.0.1:5173 se abrir por esse endereço)
CORS_ORIGINS=http://localhost:5173

# memory    = repositórios em memória (somente local/test; dados somem ao reiniciar)
# firestore = Cloud Firestore (real ou emulador). Sem configuração válida, rotas de dados respondem 503.
DATA_BACKEND=memory

# --- Firebase (deixe vazio para rodar sem Firebase: rotas administrativas respondem 503) ---
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)

# Credenciais: preferir Application Default Credentials em dev
#   (variável GOOGLE_APPLICATION_CREDENTIALS apontando para um arquivo FORA do repositório).
# Em hospedagem serverless: conteúdo JSON da conta de serviço como variável secreta do ambiente.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Somente com o Firebase Emulator Suite em desenvolvimento. Proibido em staging/produção.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Firestore Emulator: defina no AMBIENTE do processo ($env:FIRESTORE_EMULATOR_HOST = "127.0.0.1:8181"),
# não aqui — o SDK não lê este arquivo e a API recusa a variável presente só no .env. Ver docs/firestore.md.

# UIDs (Firebase Authentication) com acesso ao painel, separados por vírgula. Vazio = ninguém.
# Console → Authentication → Usuários → "UID do usuário". Guia completo: docs/autenticacao.md
ADMIN_ALLOWED_UIDS=

# --- Fotos dos produtos (Cloud Storage for Firebase). Guia: docs/storage.md ---
# disabled = envio de fotos desligado (o painel avisa; produtos salvam sem foto) | firebase = bucket abaixo
IMAGE_STORAGE=disabled
# Nome do bucket, sem gs:// (ex.: <projeto>.firebasestorage.app). O bucket real exige o plano Blaze.
FIREBASE_STORAGE_BUCKET=
# Somente com o Storage Emulator + Firestore Emulator (ou DATA_BACKEND=memory). Proibido em staging/produção.
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
