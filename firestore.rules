rules_version = '2';

// Mundo das Patas: nenhum cliente Web/mobile acessa o Firestore diretamente.
// Todo acesso passa pelo backend FastAPI (Firebase Admin SDK, que não é afetado por estas regras).
// Publicação somente manual, pelo proprietário do projeto (ver backend/README.md).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
