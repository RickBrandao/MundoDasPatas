# Frontend (Vite). Copie para .env.local (NUNCA versionado) e preencha.
# Somente configuração PÚBLICA do Firebase Web SDK: nada de senhas, tokens, contas de serviço ou chaves privadas.
# Segredos do servidor ficam em backend/.env — os dois arquivos não compartilham valores.

# demo     = painel aberto com dados fictícios, sem Firebase (padrão; usado no GitHub Pages)
# firebase = login no Firebase Authentication + autorização confirmada pelo FastAPI (GET /api/v1/admin/me)
# Qualquer outro valor, ou "firebase" com variáveis faltando, BLOQUEIA o painel (não cai para a demo).
VITE_ADMIN_AUTH_MODE=demo

# Origem dos dados comerciais (catálogo e painel):
# local = dados fictícios no navegador (padrão; usado no GitHub Pages; só com VITE_ADMIN_AUTH_MODE=demo)
# api   = FastAPI + Cloud Firestore (exige VITE_ADMIN_AUTH_MODE=firebase e VITE_API_BASE_URL)
# Combinações diferentes de demo+local e firebase+api BLOQUEIAM o painel; valor inválido não cai para os dados locais.
VITE_STORE_DATA_SOURCE=local

# URL do FastAPI, sem barra final. Obrigatória no modo firebase e com VITE_STORE_DATA_SOURCE=api.
# Use 127.0.0.1 (endereço em que o uvicorn escuta), não "localhost": no Windows o navegador tenta ::1 primeiro
# e pode cair em outro serviço na mesma porta (WSL/Docker), o que aparece como falha de conexão no painel.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Firebase Console → Configurações do projeto → Seus apps → app Web → Configuração do SDK.
# Obrigatórias no modo firebase; ignoradas no modo demo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
